# Application Environment
APP_ENV=development
APP_NAME=AutoAudit
DEBUG=true

# API Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Primary Database (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# (Standard 'postgres://' or 'postgresql://' URLs will be auto-normalized to asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autoaudit

# Redis & Celery (optional for local in-process async worker mode)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage Directories
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
EXPORT_DIR=./storage/exports
CHROMA_PERSIST_DIR=./storage/chroma

# LLM & RAG Provider (mock, gemini, or openai)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Risk Thresholds (0-100)
RISK_THRESHOLD_HIGH=75
RISK_THRESHOLD_MEDIUM=45
UNCERTAINTY_THRESHOLD=0.60
